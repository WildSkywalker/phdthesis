\contentsline {figure}{\numberline {2.1}{\ignorespaces Running time and the percentage of valid structures sampled uniformly at random from solutions of K-SAT problems. {Among all the problem sizes}, \textsc {Nelson}\xspace always generate valid solutions and is the most efficient sampler.}}{31}{figure.caption.21}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Running time, the percentage of valid solutions generated, and rounds of resampling for weighted sample generation of K-SAT solutions. {Among all the problem sizes}, \textsc {Nelson}\xspace scales the best among all approaches and always generates valid solutions. }}{31}{figure.caption.22}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Frequency histograms for the number of resample and the total time of \textsc {Nelson}\xspace method for uniformly sampling visiting paths for vehicle routing problem.}}{35}{figure.caption.27}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Implementation pipeline of the \textsc {Nelson}\xspace -CD algorithm with $m=1$. The proposed \textsc {Nelson}\xspace can be efficiently adapted to a Pytorch-based machine learning library and enforces constraint satisfaction during learning.}}{58}{figure.caption.38}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces {\textbf {(a)} An un-directed graph $G(V,E)$ where the vertices are $V=\{v_1,v_2,v_3,v_4\}$ and the un-directed edges are $E=\{e_1=(v_1,v_2),e_2=(v_1,v_3),e_3=(v_2,v_3),e_4=(v_2,v_4),e_5=(v_3,v_4)\}$. \textbf {(b)} A possible sink-free orientation of the edges in the graph and its matrix representation $x$, where every vertex has at least one outgoing edge. }}}{61}{figure.caption.42}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces The distribution of resampling steps in the \textsc {Nelson}\xspace and Algorithmic-LLL~\citep {DBLP:journals/jacm/MoserT10}. Both of them get a valid sample within $T_{\mathit {tryouts}}$. \textsc {Nelson}\xspace takes much fewer resamples than Algorithmic-LLL because it resamples all the violated clauses at every iteration while Algorithmic-LLL only resamples one of them.}}{67}{figure.caption.45}%
